# Copie para .env (nunca versione o .env).

# Opcional: tracing no LangSmith / LangGraph Studio.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=

# Opcional: arquivos alternativos de configuração e política.
# AI_ORCH_CONFIG=config/orchestrator.yaml
# AI_ORCH_POLICY=policies/default.yaml

# NÃO defina ANTHROPIC_API_KEY para o provider claude_code: o Claude Code passaria a
# cobrar pela API em vez de usar sua assinatura. O orquestrador remove essa variável do
# ambiente dos agentes de qualquer forma. Ela só será usada pelo provider anthropic_api
# (Fase 2/4), quando implementado.
